# ===========================================
# Claude Vision MCP — Configuration
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ===========================================

# API Key for your vision model provider (REQUIRED)
# DashScope (Alibaba Cloud): https://bailian.console.aliyun.com/
# OpenAI: https://platform.openai.com/api-keys
# Anthropic: https://console.anthropic.com/
VISION_API_KEY=sk-your-key-here

# API base URL (OpenAI-compatible /chat/completions endpoint)
# DashScope (default): https://dashscope.aliyuncs.com/compatible-mode/v1
# OpenAI: https://api.openai.com/v1
# Anthropic: (use a compatible proxy/gateway)
VISION_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Max tokens per response
VISION_MAX_TOKENS=4096

# Custom vision models (comma-separated, fallback in order).
# Leave empty to use defaults:
# qwen3.5-plus,qwen3.5-omni-plus-2026-03-15,qwen3.5-omni-plus
# Examples:
# VISION_MODELS=qwen3.5-plus,qwen3.5-omni-plus
# VISION_MODELS=gpt-4o,gpt-4o-mini
